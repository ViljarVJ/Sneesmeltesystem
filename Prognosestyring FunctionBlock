FUNCTION_BLOCK prognose
VAR_INPUT
    // ── Værvarselsdata fra Python (oppdateres f.eks. hvert 30. minutt) ──────
    // Timevis prognose, indeks 0 = neste hele time, 23 = 24 timer frem
    prognose_temp       : ARRAY[0..23] OF REAL;		// Utetemperatur [°C]
    prognose_nedbor     : ARRAY[0..23] OF REAL;		// Nedbørsmengde [mm/t]
    prognose_vind       : ARRAY[0..23] OF REAL;		// Vindhastighet [m/s]

    // ── Nåtilstand ──────────────────────────────────────────────────────────
    ute_temp_na         : REAL;                     // Faktisk utetemperatur nå [°C]
    bakke_temp          : ARRAY[1..20] OF REAL;     // Faktisk bakketemperatur per sone [°C]

    // ── Brukerens grunninnstillinger (pass-through når prediktiv er av) ─────
    base_frost_grense   : REAL;     // Normal frostgrense for å gå i standby [°C]
    base_smelte_grense  : REAL;     // Normal smeltegrense for å gå i running [°C]
	base_fukt_grense	: REAL;		// Normal fuktgrense for å gå i running [%]
    base_min_pumpe      : REAL;     // Normalt minimum pumpesignal [%]
    base_max_pumpe      : REAL;     // Normalt maksimum pumpesignal [%]

    // ── Prediktive tuningsparametre ──────────────────────────────────────────
    forvarme_horisont   : REAL := 6.0;	// Hvor mange timer frem vi ser etter snøhendelser [t] Anbefalt: 3–8 t avhengig av termisk tregheten til banen
    maks_onsket_temp_okning : REAL := 3.0;	// Hvor mye vi hever onsket_temp under forvarmning [°C] Heves gradvis jo nærmere snøhendelsen er
    grense_endring         : REAL := 1.5;	// Hvor mye vi hever frost_grense / smelte_grense for tidlig aktivering [°C] Gjør at sonene starter standby/running litt tidligere enn normalt
    min_pumpe_okning     : REAL := 15.0;	// Ekstra minimum pumpeprosent under forvarmning [%] Hindrer at pumpen stopper helt mens banen forvarmes
    vind_kjoele_faktor  : REAL := 0.16;	// Justeringsfaktor for vindavkjøling (standard vindkjøleformel) Følger wind chill index
    aktiver_prediktiv   : BOOL := FALSE;	// Slå prediktiv styring av/på
END_VAR

VAR_OUTPUT
    // ── Justerte setpunkter – kobles direkte til smelte_regulering ──────────
    ut_frost_grense     : REAL;     // Justert frostgrense
    ut_smelte_grense    : REAL;     // Justert smeltegrense
	ut_fukt_grense		: REAL;		// Justert fuktgrense
    ut_min_pumpe        : REAL;     // Justert minimum pumpe
    ut_max_pumpe        : REAL;     // Uendret, sendt videre

    // ── Statusinformasjon ────────────────────────────────────────────────────
    snoe_risiko         : REAL;     // Beregnet snørisiko 0–100
    timer_til_sno		: REAL;     	// Timer til første forventede snøhendelse (-1 = ingen)
    forvarme_aktiv		: BOOL;     // TRUE mens prediktiv forvarmning pågår
    forvarme_intensitet : REAL;     // 0–100 % — hvor aggressivt vi forvarmer
    vind_prognose_temp	: ARRAY[0..23] OF REAL;     	// Beregnet vindkjølt temperatur [°C]
END_VAR

VAR
    i                   : INT;

    // Interne beregningsvariabler
    forste_sno_time    : REAL;     // Indeks (timer) til første snøhendelse
    sno_funnet         : BOOL;
    sum_sno_mm         : REAL;     // Total forventet snønedbør innen horisonten
    min_prognose_temp   : REAL;     // Laveste temperatur innen horisonten

    intensitet_raa      : REAL;     // Ubehandlet intensitetsverdi 0–1
    tid_igjen_normert   : REAL;     // 0 = snøen er her, 1 = akkurat innenfor horisont
    temp_bidrag         : REAL;
    nedbor_bidrag       : REAL;
    vind_bidrag         : REAL;
    horisont_heltall    : INT;      // Horisont avrundet til heltall timer (maks 23)
END_VAR

//Beskytte mot dårlig input
IF forvarme_horisont < 1.0 THEN forvarme_horisont := 1.0; END_IF
IF forvarme_horisont > 23.0 THEN forvarme_horisont := 23.0; END_IF
horisont_heltall := REAL_TO_INT(forvarme_horisont);

//Finner første snøhendelse, total snø, laveste temp
sno_funnet      := FALSE;
forste_sno_time := -1.0;
sum_sno_mm      := 0.0;
min_prognose_temp := prognose_temp[0];

FOR i := 0 TO horisont_heltall DO
	//Regner ut hvor mye vinden påvirker temperaturen
	IF prognose_vind[i] > 1.3 AND prognose_temp[i] < 10.0 THEN
    	vind_prognose_temp[i] := 13.12
					 			+ 0.6215  * prognose_temp[i]
								- 11.37   * EXPT(prognose_vind[i] * 3.6, vind_kjoele_faktor)
								+ 0.3965  * prognose_temp[i] * EXPT(prognose_vind[i] * 3.6, vind_kjoele_faktor);
	ELSE
		vind_prognose_temp[i] := prognose_temp[i];
	END_IF

    // Registrer laveste temperatur 
    IF vind_prognose_temp[i] < min_prognose_temp THEN
        min_prognose_temp := vind_prognose_temp[i];
    END_IF

    // Finner ut om det kommer snø basert på forventet nedbør og temperatur
    IF (vind_prognose_temp[i] <= 0 AND prognose_nedbor[i] > 0.1) THEN

        sum_sno_mm := sum_sno_mm + prognose_nedbor[i];

        IF NOT sno_funnet THEN
            forste_sno_time := INT_TO_REAL(i);
            sno_funnet := TRUE;
        END_IF
	END_IF
END_FOR

timer_til_sno := forste_sno_time;  // -1 hvis ingen hendelse funnet

// Risiko bergening  (0–100)%
//    Tre bidrag vektet sammen:
//      – Temperaturrisiko : lavere temp → høyere risiko
//      – Nedbørsrisiko    : mer nedbør → høyere risiko
//      – Vindrisiko       : sterk vind forsterker nedkjøling

// Temperaturbidrag: 0 ved +5 °C eller mer, 100 ved -10 °C eller mindre
temp_bidrag := LIMIT(0.0, (5.0 - min_prognose_temp) / 15.0 * 100.0, 100.0);

// Nedbørsbidrag: 0 ved 0 mm eller mindre, 100 ved ≥10 mm total nedbør i vinduet
nedbor_bidrag := LIMIT(0.0, sum_sno_mm / 10.0 * 100.0, 100.0);

// Vindbidrag: 0 ved 0 m/s eller mindre, 100 ved ≥15 m/s
vind_bidrag := LIMIT(0.0, prognose_vind[0] / 15.0 * 100.0, 100.0);

// Vektet sum  (temperatur teller mest for bakke-systemet)
snoe_risiko := LIMIT(0.0,
    0.50 * temp_bidrag
  + 0.35 * nedbor_bidrag
  + 0.15 * vind_bidrag,
  100.0);

// Beregner forvarme intensitet  (0–1 brukes videre, 0–100 for å vise bruker)
//    Intensiteten trappes opp jo nærmere snøhendelsen vi er.
//    Ingen snøhendelse innen horisonten gjør at intensitet = 0
intensitet_raa := 0.0;

IF aktiver_prediktiv AND sno_funnet THEN
    // Normaliser: 0 = snøen er her, 1 = akkurat på horisonten
    tid_igjen_normert := LIMIT(0.0, forste_sno_time / forvarme_horisont, 1.0);

    // Lineær opptrapping: tidligst = 30 % intensitet, nærmer seg = 100 %
    intensitet_raa := LIMIT(0.0, 1.0 - (0.7 * tid_igjen_normert), 1.0);

    // I tillegg skaleres med risikoscoren (sterk storm → enda mer aggressiv)
    intensitet_raa := intensitet_raa * (0.5 + 0.5 * (snoe_risiko / 100.0));
END_IF

forvarme_aktiv      := intensitet_raa > 0.0;
forvarme_intensitet := LIMIT(0.0, intensitet_raa * 100.0, 100.0);

// Justerer sett punkter
//    Alle utganger faller tilbake til brukerens basisverdier når prediktiv er av
//    eller ingen snø er forventet.
IF aktiver_prediktiv AND forvarme_aktiv THEN

    // Hev frost-, fukt- og smeltegrensene litt slik at sonene aktiverer seg tidligere
    ut_frost_grense  := base_frost_grense  + grense_endring * intensitet_raa;
    ut_smelte_grense := base_smelte_grense + grense_endring * intensitet_raa;
	ut_fukt_grense   := base_fukt_grense   - base_fukt_grense * intensitet_raa;

    // Hev minimum pumpe for å hindre pumpen i å stoppe under forvarmning
    ut_min_pumpe     := LIMIT(base_min_pumpe,
                              base_min_pumpe + min_pumpe_okning * forvarme_intensitet,
                              base_max_pumpe * 0.8);
    ut_max_pumpe     := base_max_pumpe;

ELSE
    // Pass-through når prediktiv styring gjør ingenting (enten ved avskrudd eller ved ingen forventet snø)
    ut_frost_grense  := base_frost_grense;
    ut_smelte_grense := base_smelte_grense;
	ut_fukt_grense	 := base_fukt_grense;
    ut_min_pumpe     := base_min_pumpe;
    ut_max_pumpe     := base_max_pumpe;
END_IF
